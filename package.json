{
  "name": "@mcptoolshop/claude-rpg",
  "version": "1.7.0",
  "description": "Simulation-grounded narrative RPG where worlds are generated live, but truth remains coherent",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "claude-rpg": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit",
    "verify": "npm run typecheck && npm run typecheck:test && npm run test:coverage"
  },
  "dependencies": {
    "@ai-rpg-engine/audio-director": "^3.11.0",
    "@ai-rpg-engine/campaign-memory": "^3.11.0",
    "@ai-rpg-engine/character-creation": "^3.11.0",
    "@ai-rpg-engine/character-profile": "^3.11.0",
    "@ai-rpg-engine/content-schema": "^3.11.0",
    "@ai-rpg-engine/core": "^3.11.0",
    "@ai-rpg-engine/equipment": "^3.11.0",
    "@ai-rpg-engine/modules": "^3.11.0",
    "@ai-rpg-engine/pack-registry": "^3.11.0",
    "@ai-rpg-engine/presentation": "^3.11.0",
    "@ai-rpg-engine/rumor-system": "^3.11.0",
    "@ai-rpg-engine/soundpack-core": "^3.11.0",
    "@ai-rpg-engine/starter-bounty-hunter": "^3.11.0",
    "@ai-rpg-engine/starter-colony": "^3.11.0",
    "@ai-rpg-engine/starter-cyberpunk": "^3.11.0",
    "@ai-rpg-engine/starter-detective": "^3.11.0",
    "@ai-rpg-engine/starter-fantasy": "^3.11.0",
    "@ai-rpg-engine/starter-gladiator": "^3.11.0",
    "@ai-rpg-engine/starter-merchant": "^3.11.0",
    "@ai-rpg-engine/starter-pirate": "^3.11.0",
    "@ai-rpg-engine/starter-ronin": "^3.11.0",
    "@ai-rpg-engine/starter-vampire": "^3.11.0",
    "@ai-rpg-engine/starter-weird-west": "^3.11.0",
    "@ai-rpg-engine/starter-zombie": "^3.11.0",
    "@anthropic-ai/sdk": "^0.39.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "esbuild": "^0.27.3",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "rpg",
    "claude",
    "ai",
    "narrative",
    "simulation",
    "worldbuilding",
    "text-rpg",
    "deterministic"
  ],
  "author": "mcp-tool-shop",
  "license": "MIT",
  "homepage": "https://github.com/mcp-tool-shop-org/claude-rpg",
  "repository": {
    "type": "git",
    "url": "https://github.com/mcp-tool-shop-org/claude-rpg.git"
  },
  "bugs": {
    "url": "https://github.com/mcp-tool-shop-org/claude-rpg/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
