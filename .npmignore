# npm force-includes all README* files regardless of .npmignore rules.
# The README.*.md rule below is ineffective; translations are included in the tarball.
# This adds ~140KB to every `npx claude-rpg` cold-start install for English-only users.
# To exclude README translations, they must be moved to a separate `translations/` directory
# (requires: moving files, updating package.json files field, linking from main README).
README.*.md

# Exclude non-package files
SHIP_GATE.md
SECURITY.md
multitask.md
.github/
site/
docs/
coverage/
*.tsbuildinfo

# The following rules are defensive/redundant and exist to explicitly
# document what should never be packaged, even if package.json's files field changes.
# Currently, package.json limits distribution to ['dist', 'CHANGELOG.md'], which already
# excludes these paths. If the files field is later expanded to include 'src/', 'test/',
# or 'scripts/', these rules will prevent accidental inclusion of development artifacts.
# Maintain this documentation for clarity and to reduce risk of unintended packaging
# changes in future maintenance.
scripts/
test/
tsconfig.test.json
